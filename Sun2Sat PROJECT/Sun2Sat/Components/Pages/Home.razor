@page "/"
@inject EventService Events

<PageTitle>Sun2Sat</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <h1>Sun2Sat Connect</h1>
        <p class="lead">Track your week, see what your connections are up to, and find people who share your plans.</p>
        <a class="btn btn-primary me-2" href="Account/Register">Create an account</a>
        <a class="btn btn-outline-primary" href="Account/Login">Log in</a>
    </NotAuthorized>
    <Authorized>
        @* ---- toolbar ---- *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h1 class="h3 mb-0 me-2">@WeekTitle</h1>

            <div class="btn-group" role="group" aria-label="Change week">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWeekAsync(-1)" aria-label="Previous week">‹</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWeekAsync(0)">Today</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWeekAsync(1)" aria-label="Next week">›</button>
            </div>

            <div class="btn-group" role="group" aria-label="View">
                <button class="btn btn-sm @(listView ? "btn-outline-primary" : "btn-primary")" @onclick="() => listView = false">Week</button>
                <button class="btn btn-sm @(listView ? "btn-primary" : "btn-outline-primary")" @onclick="() => listView = true">List</button>
            </div>

            <div class="form-check form-switch ms-1 mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="show-conn"
                       checked="@includeConnections" @onchange="ToggleConnectionsAsync" />
                <label class="form-check-label" for="show-conn">Connections' events</label>
            </div>

            <a class="btn btn-success btn-sm ms-auto" href="events/add">+ Add event</a>
        </div>

        @if (loading)
        {
            <p>Loading…</p>
        }
        else if (listView)
        {
            @* ---- list view: only days that have something ---- *@
            if (items.Count == 0)
            {
                <p class="text-secondary">Nothing this week. <a href="events/add">Add an event</a>.</p>
            }
            foreach (var group in items.GroupBy(i => i.StartLocal.Date))
            {
                <h6 class="mt-3 @(group.Key == today ? "text-primary" : "")">
                    @group.Key.ToString("dddd, MMM d") @(group.Key == today ? "· Today" : "")
                </h6>
                foreach (var item in group)
                {
                    <CalendarItemCard Item="item" />
                }
            }
        }
        else
        {
            @* ---- week view: Sunday to Saturday columns ---- *@
            <div class="week-grid">
                @for (var d = 0; d < 7; d++)
                {
                    var day = weekStart.AddDays(d);
                    var dayItems = items.Where(i => i.StartLocal.Date == day).ToList();

                    <div class="week-day @(day == today ? "is-today" : "")">
                        <div class="week-day-header">
                            <span>@day.ToString("ddd")</span>
                            <span class="week-day-num">@day.Day</span>
                            <a class="week-day-add" href="@($"events/add?date={day:yyyy-MM-dd}")" title="Add event on this day">+</a>
                        </div>
                        @foreach (var item in dayItems)
                        {
                            <CalendarItemCard Item="item" ShowDetails="false" />
                        }
                    </div>
                }
            </div>
        }

        <div class="d-flex flex-wrap gap-3 mt-3 small text-secondary">
            <span><span class="legend legend-mine"></span> Your events</span>
            <span><span class="legend legend-going"></span> Going</span>
            <span><span class="legend legend-interested"></span> Interested</span>
            <span><span class="legend legend-connection"></span> Connections' events</span>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? userId;
    private DateTime today;
    private DateTime weekStart;
    private bool listView;
    private bool includeConnections = true;
    private bool loading = true;
    private List<CalendarItem> items = new();

    private string WeekTitle
    {
        get
        {
            var end = weekStart.AddDays(6);
            return weekStart.Month == end.Month
                ? $"{weekStart:MMM d} – {end:d, yyyy}"
                : $"{weekStart:MMM d} – {end:MMM d, yyyy}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        today = AppTime.NowLocal.Date;
        weekStart = AppTime.WeekStart(today);
        userId = await AuthState.GetUserIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (userId is null)
        {
            loading = false;
            return;
        }

        loading = true;
        var fromUtc = AppTime.ToUtc(weekStart);
        var toUtc = AppTime.ToUtc(weekStart.AddDays(7));
        items = await Events.GetCalendarAsync(userId, fromUtc, toUtc, includeConnections);
        loading = false;
    }

    /// <summary>-1 = previous week, 1 = next week, 0 = back to this week.</summary>
    private async Task MoveWeekAsync(int weeks)
    {
        weekStart = weeks == 0 ? AppTime.WeekStart(today) : weekStart.AddDays(7 * weeks);
        await LoadAsync();
    }

    private async Task ToggleConnectionsAsync(ChangeEventArgs e)
    {
        includeConnections = e.Value is true;
        await LoadAsync();
    }
}
